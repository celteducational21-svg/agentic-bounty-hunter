@@ -0,0 +1,34 @@
+package godotenv
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestUnquotedWhitespaceAndNewlines(t *testing.T) {
+	tests := []struct {
+		name, input string
+		want        map[string]string
+	}{
+		{"spaces", "MY_ENV=foo bar", map[string]string{"MY_ENV": "foo bar"}},
+		{"tabs and trailing spaces", "MY_ENV=foo\tbar  \t", map[string]string{"MY_ENV": "foo\tbar"}},
+		{"following assignment", "MY_ENV=foo bar\nNEXT=baz qux\n", map[string]string{"MY_ENV": "foo bar", "NEXT": "baz qux"}},
+		{"crlf", "MY_ENV=foo bar\r\nNEXT=baz\r\n", map[string]string{"MY_ENV": "foo bar", "NEXT": "baz"}},
+		{"empty and blank lines", "EMPTY=\n\nMY_ENV=foo bar\n", map[string]string{"EMPTY": "", "MY_ENV": "foo bar"}},
+		{"inline comment", "MY_ENV=foo bar # ignored\nNEXT=value", map[string]string{"MY_ENV": "foo bar", "NEXT": "value"}},
+		{"hash in value", "MY_ENV=foo#bar baz#qux # ignored", map[string]string{"MY_ENV": "foo#bar baz#qux"}},
+		{"variable expansion", "FOO=hello\nMY_ENV=$FOO world", map[string]string{"FOO": "hello", "MY_ENV": "hello world"}},
+		{"quoted control", "MY_ENV=\"foo bar\"\nNEXT='baz qux'", map[string]string{"MY_ENV": "foo bar", "NEXT": "baz qux"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Unmarshal(tt.input)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Fatalf("got %#v, want %#v", got, tt.want)
+			}
+		})
+	}
+}
