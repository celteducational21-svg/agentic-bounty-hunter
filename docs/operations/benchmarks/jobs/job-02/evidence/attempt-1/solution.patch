+@pytest.mark.parametrize("quote_mode", ["always", "auto", "never"])
+@pytest.mark.parametrize("before", ["", "VALUE=old\nOTHER=keep\n"])
+@pytest.mark.parametrize(
+    "value",
+    [
+        r"C:\Users",
+        r"\d+",
+        r"\\server\share",
+        r"\\d+",
+        "C:\\Users\\",
+        "\\" * 4,
+        "before" + "\\" * 2 + "'after",
+        "'quoted'",
+    ],
+)
+def test_set_key_backslash_round_trip(dotenv_path, quote_mode, before, value):
+    dotenv_path.write_text(before)
+
+    result = dotenv.set_key(dotenv_path, "VALUE", value, quote_mode=quote_mode)
+
+    assert result == (True, "VALUE", value)
+    if quote_mode == "never":
+        assert dotenv_path.read_text().startswith(f"VALUE={value}\n")
+    else:
+        assert dotenv.get_key(dotenv_path, "VALUE") == value
+    if before:
+        assert dotenv.get_key(dotenv_path, "OTHER") == "keep"
+
