+
+// readerFromRecorder exercises the underlying ReaderFrom fast path.
+type readerFromRecorder struct {
+	*httptest.ResponseRecorder
+}
+
+func (r *readerFromRecorder) ReadFrom(src io.Reader) (int64, error) {
+	return io.Copy(r.ResponseRecorder, src)
+}
+
+func TestHttpFancyWriterReadFromCountsBytesOnce(t *testing.T) {
+	for _, tee := range []bool{false, true} {
+		for _, writerTo := range []bool{false, true} {
+			name := fmt.Sprintf("tee=%v/writerTo=%v", tee, writerTo)
+			t.Run(name, func(t *testing.T) {
+				original := &readerFromRecorder{httptest.NewRecorder()}
+				f := &httpFancyWriter{basicWriter: basicWriter{ResponseWriter: original}}
+				var teeBuf bytes.Buffer
+				if tee {
+					f.Tee(&teeBuf)
+				}
+				_, err := f.Write([]byte("prefix:"))
+				assertNoError(t, err)
+				var input io.Reader = strings.NewReader("hello world")
+				if !writerTo {
+					input = struct{ io.Reader }{input}
+				}
+				n, err := f.ReadFrom(input)
+				assertNoError(t, err)
+				assertEqual(t, int64(11), n)
+				assertEqual(t, "prefix:hello world", original.Body.String())
+				assertEqual(t, 18, f.BytesWritten())
+				assertEqual(t, http.StatusOK, f.Status())
+				if tee {
+					assertEqual(t, "prefix:hello world", teeBuf.String())
+				}
+			})
+		}
+	}
+}
