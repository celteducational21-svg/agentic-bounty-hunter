diff --git a/tests/test_fileutils_pathlike.py b/tests/test_fileutils_pathlike.py
new file mode 100644
index 0000000..3b09ed1
--- /dev/null
+++ b/tests/test_fileutils_pathlike.py
@@ -0,0 +1,66 @@
+import os
+from pathlib import Path
+
+import pytest
+
+from boltons.fileutils import atomic_save, iter_find_files, path_to_unicode
+from boltons.pathutils import augpath, expandpath, shrinkuser
+
+
+class FileSystemPath:
+    def __init__(self, path):
+        self.path = path
+
+    def __fspath__(self):
+        return self.path
+
+    def __str__(self):
+        raise AssertionError('Use the filesystem path protocol, not str()')
+
+
+@pytest.mark.parametrize('path_type', [str, Path, FileSystemPath, os.fsencode])
+def test_atomic_save_pathlike(tmp_path, path_type):
+    dest = tmp_path / 'destination.txt'
+    with atomic_save(path_type(str(dest))) as output:
+        output.write(b'complete')
+        assert not dest.exists()
+    assert dest.read_bytes() == b'complete'
+    assert not (tmp_path / 'destination.txt.part').exists()
+    with pytest.raises(RuntimeError):
+        with atomic_save(path_type(str(dest))) as output:
+            output.write(b'incomplete')
+            raise RuntimeError('abort')
+    assert dest.read_bytes() == b'complete'
+    assert not (tmp_path / 'destination.txt.part').exists()
+
+
+@pytest.mark.parametrize('path_type', [str, Path, FileSystemPath, os.fsencode])
+def test_find_files_pathlike(tmp_path, path_type):
+    (tmp_path / 'one.txt').write_text('one')
+    child = tmp_path / 'child'
+    child.mkdir()
+    (child / 'two.txt').write_text('two')
+    directory = path_type(str(tmp_path))
+    assert list(iter_find_files(directory, '*.txt', max_depth=0)) == [str(tmp_path / 'one.txt')]
+    assert sorted(iter_find_files(directory, '*.txt')) == sorted([str(tmp_path / 'one.txt'), str(child / 'two.txt')])
+
+
+@pytest.mark.parametrize('path', ['example', b'example', Path('example'), FileSystemPath('example'), FileSystemPath(b'example')])
+def test_path_to_unicode_pathlike(path):
+    assert path_to_unicode(path) == 'example'
+
+
+def test_pathutils_pathlike_controls():
+    assert augpath(Path('example.txt'), suffix='_new') == 'example_new.txt'
+    assert expandpath(Path('example.txt')) == 'example.txt'
+    assert shrinkuser(Path(os.path.expanduser('~'))) == '~'
+
+
+@pytest.mark.parametrize('part_file', [Path('custom.part'), FileSystemPath('custom.part'), FileSystemPath(b'custom.part')])
+def test_atomic_save_pathlike_part_file(tmp_path, part_file):
+    dest = tmp_path / 'destination.txt'
+    with atomic_save(dest, part_file=part_file) as output:
+        output.write(b'complete')
+        assert (tmp_path / 'custom.part').exists()
+    assert dest.read_bytes() == b'complete'
+    assert not (tmp_path / 'custom.part').exists()
