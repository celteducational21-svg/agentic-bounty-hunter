+@pytest.mark.skipif(not is_py310_plus, reason="3.10+ only")
+def test_annotated_optional():
+    """Annotated optionals dispatch using their underlying union type."""
+    from typing import Annotated
+
+    from cattrs.preconf.json import make_converter
+
+    converter = make_converter()
+
+    @define
+    class Example:
+        value: Annotated[str | None, "required"]
+
+    for value in ("test", None):
+        instance = converter.structure({"value": value}, Example)
+
+        assert instance == Example(value)
+        assert converter.unstructure(instance) == {"value": value}
+
+
+@pytest.mark.skipif(not is_py310_plus, reason="3.10+ only")
+def test_annotated_union_hook():
+    """Annotated unions pass the underlying type to registered hooks."""
+    from typing import Annotated
+
+    converter = Converter()
+    union = str | int
+
+    def structure_union(value, type_):
+        assert type_ == union
+        return int(value)
+
+    converter.register_structure_hook(union, structure_union)
+    converter.register_unstructure_hook(union, lambda value: str(value))
+
+    @define
+    class Example:
+        value: Annotated[str | int, "required"]
+
+    instance = converter.structure({"value": "1"}, Example)
+
+    assert instance == Example(1)
+    assert converter.unstructure(instance) == {"value": "1"}
