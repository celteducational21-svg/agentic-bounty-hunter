From 8c949104b87b91f09a96687b1a46f8e71f835538 Mon Sep 17 00:00:00 2001
From: ABH Solver A <solver-a@local.invalid>
Date: Thu, 17 Sep 2026 14:01:02 -0700
Subject: [PATCH] Handle task aborts in queue lifecycle

---
 source/index.ts | 22 +++++++++++++++++-----
 test/test.ts    | 34 ++++++++++++++++++++++++++++++++++
 2 files changed, 51 insertions(+), 5 deletions(-)

diff --git a/source/index.ts b/source/index.ts
index b91c61e..c63d579 100644
--- a/source/index.ts
+++ b/source/index.ts
@@ -238,14 +238,22 @@ export default class PQueue<QueueType extends Queue<RunFunction, EnqueueOptionsT
 			const run = async (): Promise<void> => {
 				this.#pendingCount++;
 				this.#intervalCount++;
+				let abortListener: (() => void) | undefined;
 
 				try {
 					if (options.signal?.aborted) {
 						// TODO: Use ABORT_ERR code when targeting Node.js 16 (https://nodejs.org/docs/latest-v16.x/api/errors.html#abort_err)
-						reject(new AbortError('The task was aborted.'));
-						return;
+						throw new AbortError('The task was aborted.');
 					}
 
+					const abortPromise = options.signal ? new Promise<never>((_resolve, reject) => {
+						abortListener = () => {
+							reject(new AbortError('The task was aborted.'));
+						};
+
+						options.signal!.addEventListener('abort', abortListener, {once: true});
+					}) : undefined;
+
 					const operation = (this.timeout === undefined && options.timeout === undefined) ? fn({signal: options.signal}) : pTimeout(
 						Promise.resolve(fn({signal: options.signal})),
 						(options.timeout === undefined ? this.timeout : options.timeout)!,
@@ -258,15 +266,19 @@ export default class PQueue<QueueType extends Queue<RunFunction, EnqueueOptionsT
 						},
 					);
 
-					const result = await operation;
+					const result = await (abortPromise ? Promise.race([operation, abortPromise]) : operation);
 					resolve(result!);
 					this.emit('completed', result);
 				} catch (error: unknown) {
 					reject(error);
 					this.emit('error', error);
-				}
+				} finally {
+					if (abortListener) {
+						options.signal!.removeEventListener('abort', abortListener);
+					}
 
-				this.#next();
+					this.#next();
+				}
 			};
 
 			this.#queue.enqueue(run, options);
diff --git a/test/test.ts b/test/test.ts
index c8ce4be..188b8d8 100644
--- a/test/test.ts
+++ b/test/test.ts
@@ -1107,6 +1107,40 @@ test('should skip an aborted job', async t => {
 	});
 });
 
+test('should drain when multiple jobs are aborted in the same turn', async t => {
+	const queue = new PQueue({concurrency: 1});
+	const firstController = new AbortController();
+	const secondController = new AbortController();
+	const firstJob = queue.add(async () => new Promise<void>(() => {
+		// The task intentionally never settles on its own.
+	}), {signal: firstController.signal});
+	const secondJob = queue.add(async () => new Promise<void>(() => {
+		// The task intentionally never settles on its own.
+	}), {signal: secondController.signal});
+
+	setTimeout(() => {
+		firstController.abort();
+		secondController.abort();
+	}, 0);
+
+	await Promise.all([
+		t.throwsAsync(firstJob, {instanceOf: AbortError}),
+		t.throwsAsync(secondJob, {instanceOf: AbortError}),
+	]);
+
+	t.is(queue.size, 0);
+	t.is(queue.pending, 0);
+	await queue.onIdle();
+
+	t.is(await queue.add(async () => 42), 42);
+
+	const failure = new Error('failure');
+	const thrownError = await t.throwsAsync(queue.add(async () => {
+		throw failure;
+	}));
+	t.is(thrownError, failure);
+});
+
 test('should pass AbortSignal instance to job', async t => {
 	const queue = new PQueue();
 	const controller = new AbortController();
