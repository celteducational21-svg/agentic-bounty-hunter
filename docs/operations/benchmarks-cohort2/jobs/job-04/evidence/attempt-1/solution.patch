+test('should drain when multiple jobs are aborted in the same turn', async t => {
+	const queue = new PQueue({concurrency: 1});
+	const firstController = new AbortController();
+	const secondController = new AbortController();
+	const abortableJob = async ({signal}: {signal?: AbortSignal}) => new Promise<void>((resolve, reject) => {
+		signal?.addEventListener('abort', () => {
+			reject(new AbortError('The task was aborted.'));
+		}, {once: true});
+	});
+	const firstJob = queue.add(abortableJob, {signal: firstController.signal});
+	const secondJob = queue.add(abortableJob, {signal: secondController.signal});
+
+	setTimeout(() => {
+		firstController.abort();
+		secondController.abort();
+	}, 0);
+
+	await Promise.all([
+		t.throwsAsync(firstJob, {instanceOf: AbortError}),
+		t.throwsAsync(secondJob, {instanceOf: AbortError}),
+	]);
+
+	t.is(queue.size, 0);
+	t.is(queue.pending, 0);
+	await queue.onIdle();
+});
