@@ -477,6 +477,36 @@ def test_confirmation_prompt(runner, prompt, input, default, expect):
         assert "Confirm Password: " in result.output
 
 
+@pytest.mark.parametrize(
+    ("prompt_suffix", "expected"),
+    [("", "testfoo\n"), (": ", "test: foo\n"), (">", "test>foo\n")],
+)
+def test_prompt_suffix_spacing(runner, prompt_suffix, expected):
+    @click.command()
+    def cli():
+        click.prompt("test", prompt_suffix=prompt_suffix)
+
+    result = runner.invoke(cli, input="foo\n")
+
+    assert result.exception is None
+    assert result.output == expected
+
+
+@pytest.mark.parametrize(
+    ("prompt_suffix", "expected"),
+    [("", "testy\n"), (": ", "test: y\n"), (">", "test>y\n")],
+)
+def test_confirm_prompt_suffix_spacing(runner, prompt_suffix, expected):
+    @click.command()
+    def cli():
+        click.confirm("test", prompt_suffix=prompt_suffix, show_default=False)
+
+    result = runner.invoke(cli, input="y\n")
+
+    assert result.exception is None
+    assert result.output == expected
+
+
