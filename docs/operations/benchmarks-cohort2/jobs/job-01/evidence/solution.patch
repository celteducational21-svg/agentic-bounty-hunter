-            value = visible_prompt_func(" ").lower().strip()
+            echo(prompt[:-1], nl=False, err=err)
+            # Let the input function write the final character to work around
+            # an issue where readline causes backspace to clear the whole line.
+            value = visible_prompt_func(prompt[-1:]).lower().strip()
         except (KeyboardInterrupt, EOFError):
             raise Abort() from None
         if value in ("y", "yes"):
diff --git a/tests/test_termui.py b/tests/test_termui.py
