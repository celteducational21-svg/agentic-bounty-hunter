import click
from click.testing import CliRunner

for kind in ('argument','option'):
    if kind == 'argument':
        @click.command()
        @click.argument('help')
        def cli(help): click.echo(f'value={help}')
        argv=['hello']
    else:
        @click.command()
        @click.option('--help', 'help')
        def cli(help): click.echo(f'value={help}')
        argv=['--help','hello']
    r=CliRunner().invoke(cli, argv)
    print(kind, r.exit_code, repr(r.output), repr(r.exception))
